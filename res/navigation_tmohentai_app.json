{
    "config": {
        "only-validate-config-files": false,
        "delay-time-before-end": 3000,
        "max-action-page-tries": 2
    },
    "navigation": [
        {
            "type": "navigation-range-file-lines",
            "input-file-path": "<TMOHENTAI_APP_INPUT_FILE>",
            "line-pattern": "^(http://|https://).+",
            "navigation": [
                {
                    "type": "page",
                    "url": "%navRangeValue%",
                    "delay-time-before-next": 100,
                    "elements": [
                        {
                            "type": "dom-element",
                            "process-as-list": false,
                            "id": null,
                            "name": null,
                            "xpath": "//body",
                            "actions": [
                                {
                                    "type": "wait-page-load",
                                    "timeout": 30000,
                                    "delay-time-before-next": 100
                                }
                            ]
                        },
                        {
                            "type": "dom-element",
                            "process-as-list": false,
                            "id": null,
                            "name": null,
                            "xpath": "//a[contains(@class, 'md-preview-read-btn')]",
                            "actions": [
                                {
                                    "type": "clic",
                                    "delay-time-before-next": 100
                                }
                            ]
                        },
                        {
                            "type": "dom-element",
                            "process-as-list": false,
                            "id": null,
                            "name": null,
                            "xpath": "//body",
                            "actions": [
                                {
                                    "type": "wait-page-load",
                                    "timeout": 30000,
                                    "delay-time-before-next": 100
                                }
                            ]
                        },
                        {
                            "type": "dom-element",
                            "process-as-list": true,
                            "id": null,
                            "name": null,
                            "xpath": "//img",
                            "actions": [
                                {
                                    "type": "script",
                                    "script": [
                                        "var title = document.evaluate(\"//title\", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.text;",
                                        "title = title.replaceAll('\\n', '').replaceAll('|', '_')",
                                        "var url = arguments[0].src;",
                                        "var filename = title + ' ' + arguments[0].alt.replace('Página', 'Page') + '.webp';",
                                        "fetch(url)",
                                        ".then(res => res.blob())",
                                        ".then(blob => {",
                                        "    const a = document.createElement('a');",
                                        "    a.href = URL.createObjectURL(blob);",
                                        "    a.download = filename;",
                                        "    a.click();",
                                        "});",
                                        "await new Promise(r => setTimeout(r, 500));",
                                        "return filename;"
                                    ],
                                    "delay-time-before-next": 100
                                },
                                {
                                    "type": "wait-file-exist",
                                    "filepath": "C:/Users/Developer/Downloads/%lastScriptResult%",
                                    "validation-gap": 500,
                                    "timeout": 10000,
                                    "delay-time-before-next": 1
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}